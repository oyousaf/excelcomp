---
import Icon from "./Icon.astro";
import { business } from "@/data/business";
import { TOPICS } from "@/lib/contact";

const field =
  "mt-1 block w-full border-0 border-b-2 border-muted bg-transparent px-0 py-2.5 font-mono text-base text-fg transition-[border-color,background-color] duration-300 placeholder:text-muted/60 hover:border-fg focus:border-accent focus:bg-lime/5 aria-invalid:border-red-600 dark:aria-invalid:border-red-400";
const label = "label-mono text-muted";
const error = "mt-2 hidden text-sm font-semibold text-red-700 dark:text-red-300";
---

<section id="contact" class="relative isolate py-20 sm:py-28" aria-labelledby="contact-title">
  <div class="container-page grid gap-12 lg:grid-cols-[1fr_1.5fr]">
    <div class="reveal">
      <p class="label-mono text-accent">// Contact</p>
      <h2 id="contact-title" class="mt-4 text-4xl font-extrabold sm:text-5xl">
        Tell us <span class="marker">what's wrong</span>
      </h2>
      <p class="mt-5 text-lg text-muted">
        Fill in a job sheet and we'll get back to you. For anything urgent, calling is quickest.
      </p>
      <ul class="mt-8 grid gap-3">
        {
          business.phones.map((p) => (
            <li>
              <a href={p.href} class="group inline-flex items-center gap-3 py-1 font-display text-xl font-bold">
                <span class="grid size-9 place-items-center rounded-lg border-2 border-ink bg-lime text-ink transition-transform duration-500 ease-spring group-hover:-rotate-8">
                  <Icon name="phone" class="size-4" />
                </span>
                <span class="transition-colors group-hover:text-accent">{p.display}</span>
                <span class="label-mono text-muted">{p.label}</span>
              </a>
            </li>
          ))
        }
        <li>
          <a href={`mailto:${business.email}`} class="group inline-flex items-center gap-3 py-1 font-mono text-sm break-all">
            <span class="grid size-9 shrink-0 place-items-center rounded-lg border-2 border-edge bg-raised transition-transform duration-500 ease-spring group-hover:-rotate-8">
              <Icon name="mail" class="size-4" />
            </span>
            <span class="transition-colors group-hover:text-accent">{business.email}</span>
          </a>
        </li>
      </ul>
    </div>

    <form
      method="post"
      action="/api/contact"
      novalidate
      class="reveal relative overflow-hidden rounded-2xl border-2 border-edge bg-raised shadow-hard-lg"
      data-contact-form
    >
      <div class="flex items-center justify-between bg-ink px-6 py-3 text-lime">
        <span class="label-mono">Job sheet</span>
        <span class="label-mono text-paper/60">ECS / Web enquiry</span>
      </div>

      <div class="grid gap-7 p-6 sm:grid-cols-2 sm:p-8">
        <noscript>
          <p class="rounded-xl bg-amber p-4 text-ink sm:col-span-2">
            The form needs JavaScript to keep spam out. Please call or email
            <a class="underline" href={`mailto:${business.email}`}>{business.email}</a> instead.
          </p>
        </noscript>

        <div>
          <label for="cf-name" class={label}>Customer name</label>
          <input id="cf-name" name="name" type="text" autocomplete="name" required maxlength="100" class={field} aria-describedby="cf-name-error" />
          <p id="cf-name-error" class={error} data-error-for="name"></p>
        </div>

        <div>
          <label for="cf-phone" class={label}>Phone <span class="normal-case">(optional)</span></label>
          <input id="cf-phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" maxlength="30" class={field} aria-describedby="cf-phone-error" />
          <p id="cf-phone-error" class={error} data-error-for="phone"></p>
        </div>

        <div class="sm:col-span-2">
          <label for="cf-email" class={label}>Email</label>
          <input id="cf-email" name="email" type="email" autocomplete="email" required maxlength="200" class={field} aria-describedby="cf-email-error" />
          <p id="cf-email-error" class={error} data-error-for="email"></p>
        </div>

        <fieldset class="sm:col-span-2">
          <legend class={label}>Job type</legend>
          <div class="mt-3 flex flex-wrap gap-2.5">
            {
              TOPICS.map((t, i) => (
                <label class="chip relative cursor-pointer">
                  <input type="radio" name="topic" value={t} checked={i === 0} class="peer sr-only" />
                  <span class="block rounded-lg border-2 border-muted px-3.5 py-2 text-sm font-semibold transition-[border-color,background-color,color,translate,box-shadow] duration-500 ease-spring peer-checked:border-ink peer-checked:bg-lime peer-checked:text-ink peer-checked:shadow-hard-sm peer-focus-visible:outline-3 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-accent hover:-translate-y-0.5 hover:border-fg">
                    {t}
                  </span>
                </label>
              ))
            }
          </div>
        </fieldset>

        <div class="sm:col-span-2">
          <label for="cf-message" class={label}>Fault description</label>
          <textarea
            id="cf-message"
            name="message"
            rows="4"
            required
            minlength="10"
            maxlength="3000"
            placeholder="What's it doing (or not doing)? Make and model if you know it."
            class={`${field} field-sizing-content min-h-32 resize-y`}
            aria-describedby="cf-message-error"></textarea>
          <p id="cf-message-error" class={error} data-error-for="message"></p>
        </div>

        <!-- Spam traps: a field people never see, and a timestamp set by script. -->
        <div class="absolute -left-[9999px] size-px overflow-hidden" aria-hidden="true">
          <label for="cf-website">Leave this empty</label>
          <input id="cf-website" name="website" type="text" tabindex="-1" autocomplete="off" />
        </div>
        <input type="hidden" name="t" value="" />

        <div class="flex flex-wrap items-center gap-5 border-t-2 border-dashed border-line pt-6 sm:col-span-2">
          <button type="submit" class="btn-primary disabled:cursor-wait disabled:opacity-70" data-submit>
            <span data-submit-label>Submit job</span>
            <Icon name="arrow" class="size-5" />
          </button>
          <p class="text-sm text-muted">
            We only use your details to reply. <a href="/privacy" class="underline underline-offset-3">Privacy</a>
          </p>
        </div>

        <div
          role="status"
          aria-live="polite"
          tabindex="-1"
          class="hidden rounded-xl border-2 border-ink p-5 font-semibold sm:col-span-2 data-[state=error]:bg-amber data-[state=error]:text-ink data-[state=ok]:bg-lime data-[state=ok]:text-ink"
          data-form-status
        >
        </div>
      </div>
    </form>
  </div>
</section>

<script>
  import { animate } from "motion/mini";
  import { validate, type ContactResponse } from "@/lib/contact";

  const form = document.querySelector<HTMLFormElement>("[data-contact-form]");

  if (form) {
    const status = form.querySelector<HTMLElement>("[data-form-status]")!;
    const submit = form.querySelector<HTMLButtonElement>("[data-submit]")!;
    const submitLabel = form.querySelector<HTMLElement>("[data-submit-label]")!;
    const stamp = form.querySelector<HTMLInputElement>('input[name="t"]')!;
    stamp.value = Date.now().toString(36);

    const showStatus = (state: "ok" | "error", message: string) => {
      status.dataset.state = state;
      status.textContent = message;
      status.classList.remove("hidden");
      if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
        animate(status, { opacity: [0, 1], transform: ["translateY(8px)", "none"] }, { duration: 0.35, ease: [0.22, 1, 0.36, 1] });
      }
      status.focus({ preventScroll: true });
    };

    const showErrors = (errors: Record<string, string>) => {
      let first: HTMLElement | null = null;
      for (const el of form.querySelectorAll<HTMLElement>("[data-error-for]")) {
        const name = el.dataset.errorFor!;
        const input = form.elements.namedItem(name) as HTMLInputElement | null;
        const message = errors[name];
        el.textContent = message ?? "";
        el.classList.toggle("hidden", !message);
        input?.setAttribute("aria-invalid", message ? "true" : "false");
        if (message && !first) first = input;
      }
      first?.focus();
    };

    form.addEventListener("input", (e) => {
      const input = e.target as HTMLInputElement;
      if (input.getAttribute("aria-invalid") === "true") {
        const errors = validate(Object.fromEntries(new FormData(form)) as Record<string, string>).errors;
        const el = form.querySelector<HTMLElement>(`[data-error-for="${input.name}"]`);
        if (el && !errors[input.name]) {
          el.classList.add("hidden");
          input.setAttribute("aria-invalid", "false");
        }
      }
    });

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const data = new FormData(form);
      const { errors } = validate(Object.fromEntries(data) as Record<string, string>);
      showErrors(errors);
      if (Object.keys(errors).length) return;

      submit.disabled = true;
      submitLabel.textContent = "Sending…";
      try {
        const res = await fetch(form.action, { method: "POST", body: data, headers: { Accept: "application/json" } });
        const body = (await res.json()) as ContactResponse;
        if (body.ok) {
          form.reset();
          stamp.value = Date.now().toString(36);
          showStatus("ok", body.message);
        } else {
          if (body.errors) showErrors(body.errors);
          showStatus("error", body.message);
        }
      } catch {
        showStatus("error", "Something went wrong sending your message. Please call or email instead.");
      } finally {
        submit.disabled = false;
        submitLabel.textContent = "Submit job";
      }
    });
  }
</script>
