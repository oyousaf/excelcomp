---
import { getCollection } from "astro:content";
import Icon from "./Icon.astro";
import { business } from "@/data/business";

const reviews = await getCollection("reviews");
const tilts = ["-rotate-2", "rotate-1", "-rotate-1"];
---

<section id="reviews" class="relative isolate overflow-hidden py-20 sm:py-28" aria-labelledby="reviews-title">
  <div class="glow top-1/3 left-1/2 h-72 w-2/3 -translate-x-1/2" aria-hidden="true"></div>
  <div class="container-page">
    <div class="reveal flex flex-wrap items-end justify-between gap-6">
      <div class="max-w-2xl">
        <p class="label-mono text-accent">// Customer receipts</p>
        <h2 id="reviews-title" class="mt-4 text-4xl font-extrabold sm:text-5xl">What customers say</h2>
      </div>
      <a href={business.reviewsUrl} class="btn-ghost">
        Read all reviews on Google <Icon name="external" class="size-5" />
      </a>
    </div>

    <ul class="mt-14 grid items-start gap-8 md:grid-cols-3">
      {
        reviews.map(({ data }, i) => (
          <li class="reveal">
            <figure
              class:list={[
                "receipt drop-shadow-[5px_6px_0_var(--color-shadow)] transition-[rotate,translate] duration-700 ease-spring hover:-translate-y-1.5 hover:rotate-0",
                tilts[i],
              ]}
            >
              <div class="zigzag bg-paper px-7 pt-9 pb-10 font-mono text-sm text-ink">
                <p class="text-center font-semibold tracking-widest uppercase">Excel Computer Solutions</p>
                <p class="mt-1 text-center text-xs text-ink/60">Bank St · Ossett · WF5 8NW</p>
                <hr class="my-5 border-t-2 border-dashed border-ink/25" />
                <blockquote class="font-sans text-base leading-relaxed">
                  <p>“{data.quote}”</p>
                </blockquote>
                <hr class="my-5 border-t-2 border-dashed border-ink/25" />
                <figcaption class="flex justify-between gap-4 text-xs uppercase">
                  <span class="font-semibold">{data.author}</span>
                  <span class="text-ink/60">Google review</span>
                </figcaption>
                <p class="mt-5 text-center text-xs font-semibold tracking-[0.3em] uppercase">*** Thank you ***</p>
              </div>
            </figure>
          </li>
        ))
      }
    </ul>
  </div>
</section>
