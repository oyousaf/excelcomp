---
import { getCollection } from "astro:content";
import Icon from "./Icon.astro";

const services = (await getCollection("services")).sort((a, b) => a.data.order - b.data.order);
// Parts-tray layout on large screens: 4+2, 2+4, 3+3 of a six-column grid.
const spans = ["lg:col-span-4", "lg:col-span-2", "lg:col-span-2", "lg:col-span-4", "lg:col-span-3", "lg:col-span-3"];
const wide = new Set([0, 3]);
---

<section id="services" class="py-20 sm:py-28" aria-labelledby="services-title">
  <div class="container-page">
    <div class="reveal flex flex-wrap items-end justify-between gap-6">
      <div class="max-w-2xl">
        <p class="label-mono text-accent">// What we fix</p>
        <h2 id="services-title" class="mt-4 text-4xl font-extrabold sm:text-5xl">
          Whatever's wrong with it, <span class="marker">bring it in.</span>
        </h2>
      </div>
      <p class="max-w-sm text-muted">
        More than just another computer shop: honest advice, fair prices and quick response times when your
        computer stops you working.
      </p>
    </div>

    <ul class="mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-6">
      {
        services.map(({ data }, i) => (
          <li
            class:list={[
              "reveal group @container relative isolate flex flex-col overflow-hidden rounded-2xl border-2 border-edge bg-raised p-7 press",
              spans[i],
            ]}
          >
            <div
              class="glow -top-16 -right-16 size-48 opacity-0 transition-opacity duration-700 group-hover:opacity-100"
              aria-hidden="true"
            />
            {wide.has(i) && (
              <Icon
                name={data.icon}
                class="pointer-events-none absolute -right-8 bottom-6 -z-10 size-56 text-accent opacity-7 transition-[rotate,scale] duration-1000 ease-spring group-hover:scale-110 group-hover:-rotate-6"
              />
            )}
            <div class="flex items-start justify-between">
              <span class="grid size-14 place-items-center rounded-xl border-2 border-ink bg-lime text-ink transition-transform duration-700 ease-spring group-hover:-rotate-6 group-hover:scale-105">
                <Icon name={data.icon} class="size-7" />
              </span>
              <span class="label-mono rounded-md border border-line px-2 py-1 text-muted">
                ECS-{String(data.order).padStart(2, "0")}
              </span>
            </div>
            <h3 class:list={["mt-6 font-bold", wide.has(i) ? "text-3xl" : "text-2xl"]}>{data.title}</h3>
            <p class="mt-3 max-w-prose grow text-muted">{data.summary}</p>
            <ul
              class:list={[
                "mt-6 grid gap-2 border-t-2 border-dashed border-line pt-5 text-sm",
                wide.has(i) && "@lg:grid-cols-3",
              ]}
            >
              {data.points.map((p) => (
                <li class="flex gap-2">
                  <Icon name="check" class="mt-0.5 size-4 shrink-0 text-accent" />
                  {p}
                </li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>
  </div>
</section>
