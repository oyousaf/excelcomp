---
const brands = [
  { name: "Epson", note: "Specialist" },
  { name: "Canon", note: "Compatible" },
  { name: "HP", note: "Compatible" },
  { name: "Brother", note: "Compatible" },
  { name: "Kodak", note: "Compatible" },
  { name: "Ritek", note: "DVD & Blu-ray" },
];
---

<section class="relative border-y-2 border-edge bg-raised py-14" aria-labelledby="stock-title">
  <div class="container-page grid items-center gap-8 lg:grid-cols-[1fr_2.2fr]">
    <div class="reveal">
      <p class="label-mono text-accent">// On the shelf</p>
      <h2 id="stock-title" class="mt-3 text-3xl font-extrabold">In stock now</h2>
      <p class="mt-3 text-muted">Compatible inks and blank media at low prices. There's more in store, so call to check.</p>
    </div>
    <ul class="reveal flex flex-wrap gap-4" aria-label="Brands we stock">
      {
        brands.map((b, i) => (
          <li
            class:list={[
              "tag relative flex flex-col rounded-l-3xl rounded-r-lg border-2 border-edge py-2 pr-5 pl-8 press",
              i === 0 ? "border-ink bg-lime text-ink" : "bg-surface",
            ]}
          >
            <span class="font-display text-xl font-bold">{b.name}</span>
            <span class:list={["label-mono", i === 0 ? "text-ink/75" : "text-muted"]}>{b.note}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  /* Punched price-tag hole */
  .tag::before {
    content: "";
    position: absolute;
    left: 12px;
    top: 50%;
    width: 8px;
    height: 8px;
    translate: 0 -50%;
    border-radius: 999px;
    background: var(--color-raised);
    box-shadow: inset 0 0 0 2px var(--color-edge);
  }
</style>
