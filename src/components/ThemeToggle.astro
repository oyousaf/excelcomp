---
import Icon from "./Icon.astro";
---

<button
  type="button"
  data-theme-toggle
  class="group relative grid size-11 place-items-center overflow-hidden rounded-xl border-2 border-edge bg-raised text-fg shadow-hard-sm transition-[translate,box-shadow] duration-500 ease-spring hover:-translate-y-0.5 hover:shadow-hard active:translate-y-0.5 active:shadow-none"
  aria-label="Switch to dark theme"
>
  <Icon
    name="sun"
    class="col-start-1 row-start-1 size-5 transition-[rotate,scale,opacity] duration-700 ease-spring dark:scale-50 dark:-rotate-90 dark:opacity-0"
  />
  <Icon
    name="moon"
    class="col-start-1 row-start-1 size-5 scale-50 rotate-90 opacity-0 transition-[rotate,scale,opacity] duration-700 ease-spring dark:scale-100 dark:rotate-0 dark:opacity-100"
  />
</button>

<script>
  const root = document.documentElement;
  const system = matchMedia("(prefers-color-scheme: dark)");
  const current = () => (root.dataset.theme ?? (system.matches ? "dark" : "light")) as "light" | "dark";

  const label = () => {
    const next = current() === "dark" ? "light" : "dark";
    document.querySelectorAll("[data-theme-toggle]").forEach((b) => b.setAttribute("aria-label", `Switch to ${next} theme`));
  };

  label();
  system.addEventListener("change", label);

  document.querySelectorAll("[data-theme-toggle]").forEach((button) =>
    button.addEventListener("click", () => {
      const next = current() === "dark" ? "light" : "dark";
      const apply = () => {
        // Choosing the device's own theme clears the override.
        if ((next === "dark") === system.matches) delete root.dataset.theme;
        else root.dataset.theme = next;
        try {
          if (root.dataset.theme) localStorage.setItem("theme", next);
          else localStorage.removeItem("theme");
        } catch {}
        label();
      };
      const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
      if (document.startViewTransition && !reduce) document.startViewTransition(apply);
      else apply();
    }),
  );
</script>
