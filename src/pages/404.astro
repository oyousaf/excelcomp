---
import Base from "@/layouts/Base.astro";
---

<Base title="Page not found | Excel Computer Solutions" description="That page couldn't be found.">
  <section class="container-page py-28 text-center">
    <p class="label-mono text-accent">Error 404</p>
    <h1 class="mt-4 text-5xl font-extrabold">That page has gone missing.</h1>
    <p class="mx-auto mt-5 max-w-lg text-lg text-muted">It may have moved, or the link might be mistyped.</p>
    <div class="mt-10 flex flex-wrap justify-center gap-3">
      <a href="/" class="btn-primary">Back to the homepage</a>
      <a href="/#contact" class="btn-ghost">Contact us</a>
    </div>
  </section>
</Base>
