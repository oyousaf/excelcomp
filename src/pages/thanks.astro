---
import Base from "@/layouts/Base.astro";
---

<Base title="Message sent | Excel Computer Solutions" description="Thanks for getting in touch with Excel Computer Solutions.">
  <section class="container-page py-28 text-center">
    <p class="label-mono text-accent">Message sent</p>
    <h1 class="mt-4 text-5xl font-extrabold">Thanks, we'll be in touch.</h1>
    <p class="mx-auto mt-5 max-w-lg text-lg text-muted">For anything urgent, calling is the quickest way to reach us.</p>
    <a href="/" class="btn-primary mt-10">Back to the homepage</a>
  </section>
</Base>
